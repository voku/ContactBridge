# Application mode: local, test, or hosted. Hosted disables local-only destructive routes.
APP_MODE="local"

# Public URL of the backend service used for OAuth callbacks.
APP_URL="MY_APP_URL"

# Comma-separated trusted frontend origins for CORS in hosted/split deployments.
CONTACTBRIDGE_CORS_ORIGINS="http://localhost:3000"

# High-entropy secret used to encrypt stored provider tokens. Required in hosted mode.
CONTACTBRIDGE_SECRET_KEY="change-me-for-hosted-mode"

# Optional: absolute API URL used by the frontend when it is hosted separately.
# Leave unset for local development when the UI and API share the same origin.
VITE_API_BASE_URL="http://localhost:3000"
